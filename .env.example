PORT=3000
JWT_SECRET=change-me
BRAND_NAME=TakaTick
DB_PATH=./data/app.db
# Siam's bKash number — shown publicly on the landing/enroll page as the
# number buyers Send Money to. Env overrides the built-in default.
SELLER_BKASH_NUMBER=01740707570
# Admin panel login — the admin account is created from these on first boot.
# If unset, admin login is disabled (ADMIN_NOT_CONFIGURED). Use a strong
# password and never commit a real .env file.
ADMIN_EMAIL=admin@takatick.test
ADMIN_PASSWORD=change-me-strong-password
