<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.takatick.sms"
    android:versionCode="7"
    android:versionName="1.6">

    <!-- SMS porte ar server-e pathate ei permission gulo lage.
         RECEIVE_SMS — live broadcast theke payment SMS dhora (primary,
         instant poth). READ_SMS — inbox safety net: broadcast kono karone
         miss korle app khulle inbox scan kore miss kora payment SMS pathano
         hoy (shesh 7 din / 50-ta message, sudhu payment-pattern SMS).
         Siam-er siddhanto (8 Nov): Play Protect off kore sideload-i
         cholbe, tai fastest + most accurate-tai neoa hoyeche — READ_SMS
         thakle Play Protect block fire asleo install-er somoy off kore
         nilei hoy. Inbox kokhono purota pora/pathano hoy na — sudhu
         payment-er moto SMS-i server-e jay. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- v1.5 live scan: foreground service (proti 2s inbox check) +
         phone restart-er por service abar chalu kora. Foreground service
         thakle Android process-ta background-e mere fele na — tai SMS
         broadcast-o thik moto deliver hoy. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- v1.5 battery whitelist: "BACKGROUND CHALU RAKHO" button diye
         system-ke bola hoy app-tar battery optimization bondho rakhte,
         jate recents theke kete dileo / phone idle thakleo foreground
         service-ta chalu thake. Permission-ta sudhu ei request-er
         jonno — user na chaile kichu hoy na. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System SMS broadcast shunbe. BROADCAST_SMS permission chara onno app fake SMS pathate parbe na. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- v1.5 live scan service: foreground (dataSync), proti 2s inbox
             check kore. Wake lock nei — service process jibito rakhe. -->
        <service
            android:name=".ScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Phone restart-er por live scan abar chalu kore. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
