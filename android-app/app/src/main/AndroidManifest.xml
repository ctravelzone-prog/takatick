<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.takatick.sms"
    android:versionCode="5"
    android:versionName="1.4">

    <!-- SMS porte ar server-e pathate ei permission gulo lage.
         RECEIVE_SMS — live broadcast theke payment SMS dhora (primary,
         instant poth). READ_SMS — inbox safety net: broadcast kono karone
         miss korle app khulle inbox scan kore miss kora payment SMS pathano
         hoy (shesh 7 din / 50-ta message, sudhu payment-pattern SMS).
         Siam-er siddhanto (8 Nov): Play Protect off kore sideload-i
         cholbe, tai fastest + most accurate-tai neoa hoyeche — READ_SMS
         thakle Play Protect block fire asleo install-er somoy off kore
         nilei hoy. Inbox kokhono purota pora/pathano hoy na — sudhu
         payment-er moto SMS-i server-e jay. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System SMS broadcast shunbe. BROADCAST_SMS permission chara onno app fake SMS pathate parbe na. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
